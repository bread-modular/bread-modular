#!/usr/bin/env python3
"""
nudge — a reusable, agent-friendly CLI that auto-resolves tscircuit autorouter
DRC errors for Bread Modular `ts-modules` by "nudging" whitelisted component
PCB placements (pcbX/pcbY), with a per-module whitelist so only intended parts
ever move. Replaces the throwaway tools/nudge-sweep.sh / nudge-sweep2.sh.

Commands:
  plan     --module <m>    Parse errors, list implicated components + proposed
                           moves. No edits. Machine-readable with --json.
  run      --module <m>    Run the search; leave the best layout applied
                           (unless --no-apply).
  apply    --module <m>    Re-apply the best layout recorded in the state file.
  restore  --module <m>    Restore the original .circuit.tsx from the backup.
  status   --module <m>    Current error count + classification (no edits).

Global options:
  --module <name>        Module dir under ts-modules/src/  (default "8bit")
  --config <path>        Override config (default ts-modules/src/<m>/<m>.nudge.json)
  --strategy <s>         greedy (default) | grid | random
  --max-iters <n>        Max full autoroute builds (default from config: 60)
  --time-budget <sec>    Wall-clock budget (default from config: 900)
  --step <mm>            Override per-axis step (default from config)
  --no-apply             Search but do not leave the file modified (run only)
  --json                 Machine-readable output (for agents)
  --verbose              Print per-candidate score lines

Python 3 stdlib only. It shells out to `tsci`/`node` exactly like build.sh.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import math
import os
import re
import shutil
import signal
import subprocess
import sys
import time
from pathlib import Path

LIB = Path(__file__).resolve().parent / "nudge-lib"
sys.path.insert(0, str(LIB))

from classify import analyze, is_solved  # noqa: E402
from edit import format_number, load_positions, splice, splice_many  # noqa: E402
import search  # noqa: E402

REPO_ROOT = Path(__file__).resolve().parent.parent
TS_MODULES = REPO_ROOT / "ts-modules"
STATE_ROOT = REPO_ROOT / "tools" / "nudge-state"

EXIT_OK = 0
EXIT_UNSOLVED = 2
EXIT_ERROR = 3


class NudgeError(Exception):
    """Mapped to a non-zero exit code by main()."""


# ---------------------------------------------------------------------------
# Paths & config
# ---------------------------------------------------------------------------

# Bare names only — no path separators, no `..`, no absolute paths. `module` is
# a directory name (no dots); `entry` is a filename (dots allowed for ".tsx").
_MODULE_RE = re.compile(r"^[A-Za-z0-9_-]+$")
_ENTRY_RE = re.compile(r"^[A-Za-z0-9_.-]+$")


def resolve_module(module: str, require_tsx: bool = True):
    if not isinstance(module, str) or not _MODULE_RE.match(module):
        raise NudgeError(
            f"invalid --module {module!r}: must be a bare directory name "
            f"(letters, digits, '-', '_') under ts-modules/src/")
    src_root = (TS_MODULES / "src").resolve()
    mod_dir = (TS_MODULES / "src" / module).resolve()
    try:
        mod_dir.relative_to(src_root)
    except ValueError:
        raise NudgeError(
            f"--module {module!r} resolves outside ts-modules/src/ (symlink escape?)")
    tsx = mod_dir / f"{module}.circuit.tsx"
    config_path = mod_dir / f"{module}.nudge.json"
    dist_circuit = TS_MODULES / "dist" / "src" / module / module / "circuit.json"
    state_dir = STATE_ROOT / module
    if require_tsx and not tsx.exists():
        raise NudgeError(f"no entry file {tsx} (expected src/<m>/<m>.circuit.tsx)")
    return {
        "module": module,
        "mod_dir": mod_dir,
        "tsx": tsx,
        "config_path": config_path,
        "dist_circuit": dist_circuit,
        "state_dir": state_dir,
    }


def load_config(config_path: Path):
    if not config_path.exists():
        raise NudgeError(f"no config file {config_path} — write the per-module whitelist first")
    cfg = json.loads(config_path.read_text())
    cfg["entry"] = cfg.get("entry", f"{cfg.get('module', '?')}.circuit.tsx")
    return cfg


def _check_positive(v, what):
    if isinstance(v, bool) or not isinstance(v, (int, float)):
        raise NudgeError(f"{what} must be a number, got {v!r}")
    if not math.isfinite(v) or v <= 0:
        raise NudgeError(f"{what} must be a finite positive number, got {v!r}")


def _check_positive_int(v, what):
    if isinstance(v, bool) or not isinstance(v, int):
        raise NudgeError(f"{what} must be an integer, got {v!r}")
    if v <= 0:
        raise NudgeError(f"{what} must be a positive integer, got {v!r}")


def _check_step(step, what):
    if isinstance(step, dict):
        for axis in ("x", "y"):
            if axis in step:
                _check_positive(step[axis], f"{what}.{axis}")
    else:
        _check_positive(step, what)


def validate_config(cfg):
    """Reject configs that could make the tool unsafe or non-deterministic."""
    entry = cfg.get("entry", "")
    if (not isinstance(entry, str) or not _ENTRY_RE.match(entry)
            or ".." in entry or entry in (".", "..")):
        raise NudgeError(
            f"config `entry` {entry!r} must be a bare filename "
            f"(no path separators, no '..')")

    components = cfg.get("components", {})
    if not isinstance(components, dict):
        raise NudgeError("config `components` must be an object")
    never = set(cfg.get("neverMove", []))
    overlap = set(components) & never
    if overlap:
        raise NudgeError(f"names in both `components` and `neverMove`: {sorted(overlap)}")

    for name, comp in components.items():
        if not isinstance(comp, dict):
            raise NudgeError(f"component {name!r} must be an object")
        axes = comp.get("axes", ["x", "y"])
        if (not isinstance(axes, list) or not axes
                or any(a not in ("x", "y") for a in axes)):
            raise NudgeError(f"component {name!r} `axes` must be a non-empty list of 'x'/'y'")
        if len(set(axes)) != len(axes):
            raise NudgeError(f"component {name!r} `axes` must not repeat an axis")
        if "step" in comp:
            _check_step(comp["step"], f"{name}.step")
        if "range" in comp:
            _check_positive(comp["range"], f"{name}.range")

    step_defaults = cfg.get("stepDefaults")
    if step_defaults is not None:
        if not isinstance(step_defaults, dict):
            raise NudgeError("config `stepDefaults` must be an object")
        for axis, v in step_defaults.items():
            if axis not in ("x", "y"):
                raise NudgeError(f"config `stepDefaults` axis must be 'x'/'y', got {axis!r}")
            _check_positive(v, f"stepDefaults.{axis}")

    build = cfg.get("build", {})
    if "timeoutSec" in build:
        _check_positive(build["timeoutSec"], "build.timeoutSec")

    search_cfg = cfg.get("search", {})
    if "maxIterations" in search_cfg:
        _check_positive_int(search_cfg["maxIterations"], "search.maxIterations")
    if "timeBudgetSec" in search_cfg:
        _check_positive(search_cfg["timeBudgetSec"], "search.timeBudgetSec")
    if "randomK" in search_cfg:
        _check_positive_int(search_cfg["randomK"], "search.randomK")

    return cfg


def apply_overrides(cfg, args):
    """Apply CLI flag overrides onto a working copy of the config."""
    cfg = json.loads(json.dumps(cfg))  # deep copy
    search_cfg = cfg.setdefault("search", {})
    if args.strategy:
        search_cfg["strategy"] = args.strategy
    if args.max_iters is not None:
        search_cfg["maxIterations"] = args.max_iters
    if args.time_budget is not None:
        search_cfg["timeBudgetSec"] = args.time_budget
    if args.step is not None:
        for name in cfg.get("components", {}):
            cfg["components"][name]["step"] = args.step
    return cfg


# ---------------------------------------------------------------------------
# Build + classify
# ---------------------------------------------------------------------------

def _bust_cache(module: str):
    """Remove the autorouter cache (gitignored) so `tsci build` re-routes fresh.

    Deliberately does NOT touch `src/<m>/<m>.routed.json` / `<m>.sig`: those are
    git-tracked routed-board artifacts owned by build.sh (not by this tool or by
    `tsci build`), so deleting them corrupts the repo. The cache is the only
    build artifact this tool owns.
    """
    shutil.rmtree(TS_MODULES / ".tscircuit" / "cache", ignore_errors=True)


def build_and_classify(paths, cfg, bust_cache: bool = False):
    """Optionally rm cache + full `tsci build <entry>` + classify.

    `bust_cache=True` is used only by `run` (which owns the cache and needs a
    fresh autoroute per candidate). `plan`/`status` pass False so they never
    mutate any build artifact, tracked or otherwise.
    """
    module = paths["module"]
    entry = cfg.get("entry", f"{module}.circuit.tsx")
    timeout = cfg.get("build", {}).get("timeoutSec", 180)

    if bust_cache:
        _bust_cache(module)

    env = os.environ.copy()
    env["PATH"] = str(TS_MODULES / "node_modules" / ".bin") + os.pathsep + env.get("PATH", "")
    start_ts = time.time()
    try:
        proc = subprocess.run(
            ["tsci", "build", entry],
            cwd=str(paths["mod_dir"]),
            env=env,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired:
        raise NudgeError(f"tsci build timed out after {timeout}s")

    if proc.returncode != 0:
        raise NudgeError(f"tsci build failed (rc={proc.returncode}):\n{proc.stderr[-2000:]}")

    dist = paths["dist_circuit"]
    if not dist.exists():
        raise NudgeError(f"build produced no circuit.json at {dist}")
    # Freshness check: the build must have (re)written the circuit.json we read,
    # otherwise we would classify a stale artifact and misreport the score.
    if dist.stat().st_mtime < start_ts - 5:
        raise NudgeError(f"circuit.json at {dist} is stale — build did not refresh it")

    elements = json.loads(dist.read_text())
    return analyze(elements)


# ---------------------------------------------------------------------------
# Backup / state
# ---------------------------------------------------------------------------

def _sha256(b: bytes) -> str:
    return hashlib.sha256(b).hexdigest()


def ensure_backup(paths):
    """Back up the CURRENT file content and return (content, sha256).

    Always refreshes `original.tsx` to the current bytes so the backup exactly
    matches what this run starts from. This means `restore` returns to the
    pre-run state (never a stale backup from an earlier, possibly-buggy run),
    and `apply`/`restore` can verify hashes against the recorded state.
    """
    state_dir = paths["state_dir"]
    state_dir.mkdir(parents=True, exist_ok=True)
    orig = state_dir / "original.tsx"
    content = paths["tsx"].read_bytes()
    orig.write_bytes(content)
    return content, _sha256(content)


def load_state(paths):
    sf = paths["state_dir"] / "state.json"
    if not sf.exists():
        return None
    return json.loads(sf.read_text())


def write_state(paths, state):
    paths["state_dir"].mkdir(parents=True, exist_ok=True)
    (paths["state_dir"] / "state.json").write_text(json.dumps(state, indent=2) + "\n")


# ---------------------------------------------------------------------------
# plan / status
# ---------------------------------------------------------------------------

def _analysis_report(analysis):
    return {
        "score": list(analysis["score"]),
        "solved": is_solved(analysis),
        "broken": analysis["broken"],
        "classes": analysis["classes"],
        "types": analysis["types"],
        "implicated": analysis["implicated"],
    }


def cmd_plan(paths, cfg, args):
    analysis = build_and_classify(paths, cfg)
    whitelist = cfg.get("components", {})
    implicated_whitelisted = {
        n: c for n, c in analysis["implicated"].items() if n in whitelist
    }
    proposed = []
    for name in sorted(implicated_whitelisted):
        comp = whitelist[name]
        step = comp.get("step", 0.4)
        for axis in comp.get("axes", ["x", "y"]):
            s = step.get(axis, step) if isinstance(step, dict) else step
            proposed.append({"component": name, "axis": axis,
                             "moves": [f"{axis}+{format_number(s)}", f"{axis}-{format_number(s)}"]})

    report = _analysis_report(analysis)
    report["proposed_moves"] = proposed

    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print(f"module: {paths['module']}")
        print(f"score : {tuple(analysis['score'])}  solved={is_solved(analysis)}")
        print(f"classes: {analysis['classes']}")
        if analysis["broken"]:
            print("!! BROKEN build (pcb_missing_footprint_error) — source bug, not placement")
        if proposed:
            print("implicated (whitelisted) components + proposed moves:")
            for p in proposed:
                print(f"  {p['component']:>5}  {p['axis']}  {', '.join(p['moves'])}")
        else:
            print("no whitelisted components implicated")
    return EXIT_OK


def cmd_status(paths, cfg, args):
    analysis = build_and_classify(paths, cfg)
    state = load_state(paths)
    report = _analysis_report(analysis)
    if state:
        report["best_score"] = state.get("score")

    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print(f"module: {paths['module']}")
        print(f"score : {tuple(analysis['score'])}  solved={is_solved(analysis)}")
        print(f"classes: {analysis['classes']}")
        if analysis["types"]:
            print("error types:")
            for t, n in sorted(analysis["types"].items()):
                print(f"  {n:4d}  {t}")
        if state and state.get("score") is not None:
            print(f"best recorded score: {tuple(state['score'])}")
    return EXIT_OK if is_solved(analysis) else EXIT_UNSOLVED


# ---------------------------------------------------------------------------
# run
# ---------------------------------------------------------------------------

def cmd_run(paths, cfg, args):
    strategy = args.strategy or cfg.get("search", {}).get("strategy", "greedy")
    if strategy not in ("greedy", "grid", "random"):
        raise NudgeError(f"unknown strategy {strategy!r}")

    original_content, original_sha = ensure_backup(paths)
    content, positions = load_positions(paths["tsx"])

    whitelist = cfg.get("components", {})
    # Verify every whitelisted component resolves in the source with every axis
    # it is allowed to move (protects against partial coordinates in the TSX).
    missing = [n for n in whitelist if n not in positions]
    if missing:
        raise NudgeError(f"whitelisted component(s) not found in source: {missing}")
    bad_axes = []
    for n, comp in whitelist.items():
        for axis in comp.get("axes", ["x", "y"]):
            pcb_axis = "pcbX" if axis == "x" else "pcbY"
            if pcb_axis not in positions[n]:
                bad_axes.append(f"{n}.{axis}")
    if bad_axes:
        raise NudgeError(f"whitelisted component(s) missing requested coordinates: {bad_axes}")

    def write(b: bytes):
        paths["tsx"].write_bytes(b)

    def build_score():
        return build_and_classify(paths, cfg, bust_cache=True)

    def relocate():
        return load_positions(paths["tsx"])[1]

    committed = False

    def _on_signal(signum, frame):
        raise KeyboardInterrupt

    prev_handlers = {}
    for sig in (signal.SIGINT, signal.SIGTERM):
        prev_handlers[sig] = signal.getsignal(sig)
        signal.signal(sig, _on_signal)

    try:
        initial_analysis = build_score()

        log = []
        result = search.run_search(
            cfg,
            content,
            positions,
            initial_analysis,
            write,
            build_score,
            relocate,
            splice,
            strategy=strategy,
            max_iters=args.max_iters,
            time_budget=args.time_budget,
            verbose=args.verbose,
            log=log,
        )

        best_content = result["best_content"]
        best_analysis = result["best_analysis"]
        solved = result["solved"]

        # The file currently holds best_content (the search committed it). Compute
        # deltas vs the pristine backup, restricted to the whitelist.
        best_positions = load_positions(paths["tsx"])[1]
        backup_positions = load_positions(paths["state_dir"] / "original.tsx")[1]
        deltas = {}
        for name in whitelist:
            if name not in backup_positions or name not in best_positions:
                continue
            for axis in ("pcbX", "pcbY"):
                if axis not in backup_positions[name] or axis not in best_positions[name]:
                    continue
                o = backup_positions[name][axis]["value"]
                b = best_positions[name][axis]["value"]
                if round(b - o, 4) != 0.0:
                    deltas.setdefault(name, {})[axis] = round(b - o, 4)

        applied = False
        if solved and not args.no_apply:
            write(best_content)
            # Verification: rebuild the final applied candidate at least once
            # before declaring success (guards against a stale-cache false clean).
            confirm = build_score()
            if not is_solved(confirm):
                solved = False
                best_analysis = confirm
                write(original_content)
            else:
                best_analysis = confirm
                write(best_content)
                applied = True
        else:
            # solved --no-apply, or unsolved: never leave a partial/unsolved layout.
            write(original_content)

        committed = True
    finally:
        for sig, h in prev_handlers.items():
            signal.signal(sig, h)
        if not committed:
            # Restore the source byte-for-byte on ANY failure path: exception,
            # KeyboardInterrupt, SIGINT/SIGTERM. Never leave the repo dirty.
            try:
                paths["tsx"].write_bytes(original_content)
            except Exception:
                pass

    applied_sha = _sha256(paths["tsx"].read_bytes())

    # Persist state (best layout + score + log) for `apply` / `status`.
    # `best` holds ONLY whitelisted components — never `neverMove` names.
    state = {
        "module": paths["module"],
        "original_sha256": original_sha,
        "applied_sha256": applied_sha,
        "score": list(best_analysis["score"]),
        "solved": solved,
        "strategy": strategy,
        "builds": result["builds"],
        "iterations": result["iterations"],
        "deltas": deltas,
        "best": {
            name: {
                axis: best_positions[name][axis]["value"]
                for axis in ("pcbX", "pcbY")
                if axis in best_positions[name]
            }
            for name in whitelist
            if name in best_positions
        },
        "applied": applied,
        "log": log,
        "timestamp": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
    }
    write_state(paths, state)

    report = {
        "solved": solved,
        "score": list(best_analysis["score"]),
        "strategy": strategy,
        "builds": result["builds"],
        "iterations": result["iterations"],
        "applied": applied,
        "deltas": deltas,
        "log": log,
    }

    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print(f"module: {paths['module']}  strategy: {strategy}")
        print(f"baseline score: {tuple(initial_analysis['score'])}")
        print(f"final score   : {tuple(best_analysis['score'])}")
        print(f"builds: {result['builds']}  iterations: {result['iterations']}")
        if solved:
            if applied:
                print("SOLVED — best layout applied")
            else:
                print("SOLVED — best layout NOT applied (--no-apply)")
        else:
            print("NOT SOLVED within budget — original layout restored")
        if deltas:
            print("layout deltas (mm):")
            for name in sorted(deltas):
                d = deltas[name]
                print(f"  {name:>5}  " + "  ".join(f"{k}={format_number(v)}" for k, v in d.items()))

    return EXIT_OK if solved else EXIT_UNSOLVED


# ---------------------------------------------------------------------------
# apply / restore
# ---------------------------------------------------------------------------

def cmd_apply(paths, cfg, args):
    state = load_state(paths)
    if not state:
        raise NudgeError(f"no state file — run `nudge run --module {paths['module']}` first")
    if not state.get("solved"):
        raise NudgeError("state records an unsolved layout — refusing to apply; run `nudge run` first")
    best = state.get("best", {})
    if not best:
        raise NudgeError("state file has no recorded best layout")

    # Validate the current source hash so we never splice onto an unknown base.
    current_sha = _sha256(paths["tsx"].read_bytes())
    known = {state.get("original_sha256"), state.get("applied_sha256")}
    known.discard(None)
    if known and current_sha not in known:
        raise NudgeError(
            "source file has changed since the run recorded it — "
            "run `nudge restore` then `nudge apply`, or re-run `nudge run`")

    # The whitelist is authoritative: never touch a `neverMove` or non-whitelisted
    # component, even if a stale/hand-edited state file lists it.
    whitelist = cfg.get("components", {})
    never = set(cfg.get("neverMove", []))
    for name in best:
        if name in never:
            raise NudgeError(f"state references neverMove component {name!r} — refusing to touch it")
        if name not in whitelist:
            raise NudgeError(f"state references non-whitelisted component {name!r} — refusing to touch it")

    content, positions = load_positions(paths["tsx"])
    for name in best:
        if name not in positions:
            raise NudgeError(f"state references component {name!r} not present in source")

    # Splice in descending byte-offset order so earlier splices never invalidate
    # the spans of later (lower-offset) edits, even when format_number() changes
    # the token width.
    edits = [(name, axis, value) for name, axes in best.items() for axis, value in axes.items()]
    content = splice_many(content, positions, edits)
    paths["tsx"].write_bytes(content)

    out = {"module": paths["module"], "applied": True, "best": best}
    if args.json:
        print(json.dumps(out, indent=2))
    else:
        print(f"re-applied best layout for {paths['module']} ({len(best)} component(s))")
    return EXIT_OK


def cmd_restore(paths, args):
    state_dir = paths["state_dir"]
    orig = state_dir / "original.tsx"
    if not orig.exists():
        raise NudgeError(f"no backup at {orig} — nothing to restore")
    orig_content = orig.read_bytes()
    digest = _sha256(orig_content)

    state = load_state(paths)
    expected = state.get("original_sha256") if state else None
    if expected is not None and expected != digest:
        raise NudgeError(
            f"backup hash mismatch (backup {digest[:12]}… != recorded {expected[:12]}…) — "
            f"refusing to restore a stale/tampered backup")

    paths["tsx"].write_bytes(orig_content)
    out = {"module": paths["module"], "restored": True, "sha256": digest,
           "hash_verified": expected is not None}
    if args.json:
        print(json.dumps(out, indent=2))
    else:
        print(f"restored {paths['tsx']} from backup (sha256 {digest[:12]}… — verified)")
    return EXIT_OK


# ---------------------------------------------------------------------------
# CLI wiring
# ---------------------------------------------------------------------------

def build_parser():
    p = argparse.ArgumentParser(
        prog="nudge", description="Resolve tscircuit autorouter DRC errors by nudging "
        "whitelisted component PCB placements.")
    sub = p.add_subparsers(dest="command", required=True)

    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--module", default="8bit", help="module dir under ts-modules/src/")
    common.add_argument("--config", help="override config path")
    common.add_argument("--strategy", choices=["greedy", "grid", "random"], help="search strategy")
    common.add_argument("--max-iters", type=int, help="max full autoroute builds")
    common.add_argument("--time-budget", type=float, help="wall-clock budget (seconds)")
    common.add_argument("--step", type=float, help="override per-axis step (mm)")
    common.add_argument("--json", action="store_true", help="machine-readable output")
    common.add_argument("--verbose", action="store_true", help="per-candidate score lines")

    sp = sub.add_parser("plan", parents=[common], help="diagnose errors + propose moves")
    sp.add_argument("--no-apply", action="store_true", help=argparse.SUPPRESS)  # accepted, no-op

    sp = sub.add_parser("run", parents=[common], help="search + apply best layout")
    sp.add_argument("--no-apply", action="store_true", help="search but revert file at end")

    sub.add_parser("apply", parents=[common], help="re-apply best layout from state")
    sub.add_parser("restore", parents=[common], help="restore original .circuit.tsx")
    sub.add_parser("status", parents=[common], help="current error count + classification")
    return p


def main(argv=None):
    args = build_parser().parse_args(argv)

    def _err(msg, code=EXIT_ERROR):
        if args.json:
            print(json.dumps({"ok": False, "error": msg}))
        else:
            print(f"nudge: error: {msg}", file=sys.stderr)
        return code

    try:
        # `restore` must work even with no config or a missing/broken source file.
        if args.command == "restore":
            paths = resolve_module(args.module, require_tsx=False)
            return cmd_restore(paths, args)

        paths = resolve_module(args.module)
        cfg_path = Path(args.config) if args.config else paths["config_path"]
        cfg = load_config(cfg_path)
        cfg = apply_overrides(cfg, args)
        validate_config(cfg)

        if args.command == "plan":
            return cmd_plan(paths, cfg, args)
        if args.command == "status":
            return cmd_status(paths, cfg, args)
        if args.command == "run":
            return cmd_run(paths, cfg, args)
        if args.command == "apply":
            return cmd_apply(paths, cfg, args)
        return EXIT_ERROR
    except NudgeError as e:
        return _err(str(e))
    except RuntimeError as e:
        # search.run_search raises RuntimeError for a BROKEN build (a known,
        # expected "cannot nudge" condition) — surface it as a clean CLI error.
        return _err(str(e))
    except KeyboardInterrupt:
        return _err("interrupted", code=130)


if __name__ == "__main__":
    sys.exit(main())
