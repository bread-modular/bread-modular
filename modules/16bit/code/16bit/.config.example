# Select the app to build/flash during development.
#
# Copy this file to `.config` (in this directory) and set APP_NAME to the app
# you're working on. `.config` is gitignored and never committed.
#
# Valid apps: noop, sampler, polysynth, fxrack, elab, bass
#
# `scripts/build.sh` and `scripts/deploy.sh` read this automatically. You can
# still override it for a single build with: ./scripts/build.sh -DAPP_NAME=elab

APP_NAME=polysynth
