	(text "SLOT TEMPLATE (base v1.3.1) - one sheet instance = one Base slot.\nSupply socket pair, TPS2111A 2:1 power mux (IN1 = 5V_SYS, IN2 = +3.3V),\n750R ILIM, 100k SEL pulldown, rail decoupling and the 1x02 select header.\nVSLOT / SEL are sheet pins: the parent sheet wires them to VSLOT_n / SEL_n."
		(exclude_from_sim no)
		(at 25.4 96.52 0)
		(effects
			(font
				(size 1.524 1.524)
				(thickness 0.254)
				(bold yes)
			)
			(justify left)
		)
		(uuid "073f1a7a-50c9-56b9-9897-a1c58863ff8c")
	)
	(text "Shunt fitted = 5V_SYS (SEL high); shunt absent or lost = +3.3V (100k pulldown).\nModule current flows through the mux - the header carries the select level only."
		(exclude_from_sim no)
		(at 25.4 116.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "74465663-d0c5-5eeb-9b4b-b29795ca8c5f")
	)
	(text "References are annotated per sheet instance: Slot1 = U6 / J7 / R28 / R29 / C22 / C23 /\nVSUPPLY_1 / GND1 ... Slot12 = U17 / J18 / R50 / R51 / C44 / C45 / VSUPPLY_12 / GND12."
		(exclude_from_sim no)
		(at 25.4 128.27 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "be379f48-1f23-537f-b69a-5606db122eb8")
	)
	(text "Rail select: D0 is strapped low, so the mux follows D1 (SEL).\nVSUPPLY_n carries the selected rail on all five pins, GND_n the ground."
		(exclude_from_sim no)
		(at 25.4 139.7 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "682f2ddf-1410-5be4-8990-ddb7ea9e594e")
	)
	(embedded_fonts no)
)
